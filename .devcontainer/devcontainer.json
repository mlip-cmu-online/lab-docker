{
  "name": "MLiP Lab 5 - Docker",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash scripts/preflight.sh",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Wine inference service",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "docker-compose.yml",
        "docker/training/train.py",
        "docker/inference/server.py"
      ]
    }
  },
  "remoteUser": "vscode"
}
